# ── Site ────────────────────────────────────────────────────────────────
# Public URL of the website (canonical URLs, sitemap, emails). Your domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── SEO / analytics (optional) ───────────────────────────────────────────
# Google Search Console → Settings → Ownership verification → HTML tag → the "content" value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# true on a demo/staging copy (e.g. *.netlify.app) so Google does not index it. Remove on the real domain.
NEXT_PUBLIC_NOINDEX=

# ── Database (MongoDB Atlas) ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/kalgi?retryWrites=true&w=majority

# ── Admin login ──────────────────────────────────────────────────────────
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=
# First owner account, created only when the database has no users
ADMIN_EMAIL=admin@kalgihandicraft.com
ADMIN_PASSWORD=

# ── Images (Cloudinary, required in production) ──────────────────────────
# Without these, uploads go to ./.uploads on local disk (development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kalgi
# Self-hosting with a persistent disk and no Cloudinary? Set to true.
ALLOW_LOCAL_UPLOADS=false

# ── Inquiry email alerts (optional; logs to console when empty) ──────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Kalgi Handicraft <no-reply@kalgihandicraft.com>"
# Falls back to the email in Admin → Settings
NOTIFY_EMAIL=
